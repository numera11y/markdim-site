---
import SiteLayout from '../layouts/SiteLayout.astro';
import { localizePath, siteCopy } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = siteCopy[lang].home;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const downloadsUrl = localizePath(basePath, lang, 'downloads');
const repositoryUrl = 'https://github.com/numera11y/markdim';
const storeUrl = 'https://apps.microsoft.com/detail/9P28FB0M0J7B';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<SiteLayout lang={lang} page="home">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <section class="hero-stage px-5 pb-16 pt-10 sm:px-8 sm:pb-20 sm:pt-16 lg:px-12 lg:pt-20">
    <div class="mx-auto max-w-7xl">
      <div class="hero-copy mx-auto max-w-5xl text-center">
        <h1 class="display-title mx-auto max-w-[16ch] text-5xl leading-[0.98] sm:text-6xl lg:text-8xl">{copy.heroTitle}</h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-7 text-muted sm:text-xl">{copy.heroDescription}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a class="inline-flex min-h-12 items-center gap-2 rounded-md bg-accent px-5 py-3 font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover" href={downloadsUrl}>
            {copy.downloadFree} <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="inline-flex min-h-12 items-center gap-2 px-4 py-3 font-medium text-ink underline decoration-transparent underline-offset-4 hover:decoration-current" href="#features">
            {copy.seeFeatures} <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
        </div>
        <p class="mt-5 text-sm text-secondary">{copy.platformAvailability}</p>
        <ol class="workflow-route mt-8" aria-label={copy.workflowLabel}>
          <li>{copy.workflow[0]}</li>
          <li class="workflow-track" aria-hidden="true"></li>
          <li>{copy.workflow[1]}</li>
          <li class="workflow-track" aria-hidden="true"></li>
          <li>{copy.workflow[2]}</li>
        </ol>
      </div>

      <figure class="hero-capture mx-auto mt-10 max-w-7xl sm:mt-14">
        <div class="application-capture-frame">
          <a class="relative block cursor-zoom-in" href={`${basePath}${copy.screenshotImage}`} target="_blank" rel="noreferrer" aria-label={copy.screenshotLink}>
            <img
              class="block h-auto w-full"
              src={`${basePath}${copy.screenshotImage}`}
              alt={copy.screenshotAlt}
              width={lang === 'en' ? '1720' : '1606'}
              height={lang === 'en' ? '1009' : '952'}
              decoding="async"
              fetchpriority="high"
            />
            <span class="capture-zoom absolute bottom-3 right-3 inline-flex min-h-11 items-center gap-2 rounded-md border border-rule bg-page px-3 py-2 text-xs font-semibold text-accent">
              <i class="ph ph-magnifying-glass-plus text-base" aria-hidden="true"></i> {copy.zoom}
            </span>
          </a>
        </div>
        <figcaption class="mt-3 flex items-start justify-center gap-2 text-xs leading-5 text-secondary"><i class="ph ph-info mt-0.5 text-accent" aria-hidden="true"></i> {copy.screenshotCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section id="features" class="scroll-mt-8 px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="feature-intro grid gap-6 pb-9 md:grid-cols-[1fr_1fr] md:gap-16 md:pb-12">
        <h2 class="display-title max-w-[15ch] text-4xl leading-tight sm:text-5xl">{copy.featureTitle}</h2>
        <p class="reading-measure text-lg leading-7 text-muted">{copy.featureIntro}</p>
      </div>

      <div class="feature-list">
        {copy.features.map((feature) => (
          <article class="feature-line grid gap-4 py-7 md:grid-cols-[2.5rem_0.8fr_1.2fr] md:items-start md:gap-7 md:py-9">
            <i class:list={['ph', feature.icon, 'mt-1 text-2xl text-accent']} aria-hidden="true"></i>
            <h3 class="text-xl font-semibold">{feature.title}</h3>
            <p class="max-w-2xl leading-7 text-muted">{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-rule bg-page px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <h2 class="display-title max-w-[14ch] text-4xl leading-tight sm:text-5xl">{copy.workspaceTitle}</h2>
      <div class="divide-y divide-rule border-y border-rule">
        {copy.preferences.map((preference) => (
          <article class="grid gap-2 py-5 sm:grid-cols-[0.7fr_1.3fr] sm:gap-8">
            <h3 class="font-semibold">{preference.title}</h3>
            <p class="leading-6 text-muted">{preference.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h2 class="display-title max-w-[14ch] text-4xl leading-tight sm:text-5xl">{copy.privacyTitle}</h2>
        <p class="reading-measure mt-5 text-lg leading-7 text-muted">{copy.privacyText}</p>
      </div>
      <a class="inline-flex min-h-11 items-center gap-2 font-medium text-accent underline decoration-transparent underline-offset-4 hover:decoration-current" href={repositoryUrl} target="_blank" rel="noreferrer">{copy.sourceCode} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>

  <section id="microsoft-store" class="px-5 pb-16 sm:px-8 sm:pb-20 lg:px-12">
    <div class="download-panel mx-auto grid max-w-7xl gap-8 rounded-xl px-6 py-9 sm:px-10 sm:py-12 md:grid-cols-[1fr_auto] md:items-center lg:px-14">
      <div>
        <h2 class="display-title max-w-[18ch] text-3xl leading-tight sm:text-4xl">{copy.storeTitle}</h2>
        <p class="mt-4 max-w-[58ch] leading-7 text-muted">{copy.storeDescription}</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4 md:justify-end">
        <a class="store-badge inline-flex min-h-[60px] items-center gap-3 rounded-md px-4 py-2 no-underline transition-colors" href={storeUrl} target="_blank" rel="noreferrer">
          <img src={`${basePath}microsoft-store.svg`} width="34" height="34" alt="" aria-hidden="true" />
          <span class="flex flex-col text-left leading-tight"><span class="text-xs">{lang === 'fr' ? 'DISPONIBLE SUR' : 'GET IT FROM'}</span><span class="text-base font-semibold">Microsoft Store</span></span>
          <i class="ph ph-arrow-up-right ml-1" aria-hidden="true"></i>
        </a>
        <a class="inline-flex min-h-11 items-center gap-2 font-medium text-accent underline decoration-transparent underline-offset-4 hover:decoration-current" href={downloadsUrl}>{copy.downloadButton} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section id="faq" class="scroll-mt-8 border-t border-rule bg-page px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-9 md:grid-cols-[0.7fr_1.3fr] md:gap-16">
      <h2 class="display-title max-w-[11ch] text-4xl leading-tight sm:text-5xl">{copy.faqTitle}</h2>
      <div>
        {copy.faqs.map(({ question, answer }) => (
          <details class="faq-item group">
            <summary class="text-base font-medium sm:text-lg">{question}</summary>
            <p class="faq-answer">{answer}</p>
          </details>
        ))}
        <p class="mt-6 text-sm leading-6 text-secondary">{copy.support} <a class="text-link" href={`${repositoryUrl}/issues`} target="_blank" rel="noreferrer">{copy.contactOnGithub} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>.</p>
      </div>
    </div>
  </section>
</SiteLayout>
