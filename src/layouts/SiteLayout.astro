---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'markdim — éditeur Markdown gratuit et open source',
  description = 'Éditeur Markdown de bureau gratuit et open source pour lire, écrire, modifier et exporter vos fichiers .md. Bêtas publiques Windows et Linux; le projet cible aussi macOS.',
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(basePath, Astro.site);
const downloadsUrl = `${basePath}telechargement/`;
const releaseUrl = 'https://github.com/numera11y/markdim/releases/latest';
const repositoryUrl = 'https://github.com/numera11y/markdim';

const applicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'markdim',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, Linux',
  description,
  url: canonical.href,
  downloadUrl: releaseUrl,
  codeRepository: repositoryUrl,
  license: `${repositoryUrl}/blob/main/LICENSE`,
  inLanguage: 'fr',
  isAccessibleForFree: true,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'markdim',
  url: canonical.href,
  logo: new URL(`${basePath}markdim.svg`, Astro.site).href,
  sameAs: [repositoryUrl],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141820" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}markdim.svg`} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" type="application/xml" href={`${basePath}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="markdim" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(`${basePath}og-card.png`, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${basePath}og-card.png`, Astro.site).href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify([organizationSchema, applicationSchema])} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8 lg:px-12">
        <a class="flex min-h-11 items-center gap-2 no-underline" href={basePath} aria-label="markdim, accueil">
          <img class="h-[30px] w-[30px] sm:h-[34px] sm:w-[34px]" src={`${basePath}markdim.svg`} width="34" height="34" alt="" />
          <span class="text-base font-semibold tracking-tight sm:text-lg">markdim</span>
        </a>
        <nav class="flex items-center gap-3" aria-label="Navigation principale">
          <div class="desktop-nav-links flex items-center gap-7 text-sm text-muted">
            <a class="no-underline hover:text-ink" href={`${basePath}#fonctionnalites`}>Fonctionnalités</a>
            <a class="no-underline hover:text-ink" href={`${basePath}#compatibilite`}>Compatibilité</a>
            <a class="no-underline hover:text-ink" href={downloadsUrl}>Téléchargements</a>
            <a class="no-underline hover:text-ink" href={`${basePath}#questions`}>Questions</a>
          </div>
          <details class="nav-menu">
            <summary class="menu-toggle" aria-label="Afficher la navigation">
            <i class="ph ph-list" aria-hidden="true"></i>
            </summary>
            <div class="nav-links flex items-center gap-7 text-sm text-muted">
              <a class="no-underline hover:text-ink" href={`${basePath}#fonctionnalites`}>Fonctionnalités</a>
              <a class="no-underline hover:text-ink" href={`${basePath}#compatibilite`}>Compatibilité</a>
              <a class="no-underline hover:text-ink" href={downloadsUrl}>Téléchargements</a>
              <a class="no-underline hover:text-ink" href={`${basePath}#questions`}>Questions</a>
            </div>
          </details>
          <a class="inline-flex min-h-11 items-center gap-1.5 whitespace-nowrap rounded-md bg-accent px-2 py-2 text-xs font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover sm:gap-2 sm:px-4 sm:text-sm" href={downloadsUrl}>
            Télécharger <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </nav>
      </div>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="border-t border-rule bg-paper">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-9 sm:grid-cols-[1fr_auto] sm:items-end sm:px-8 lg:px-12">
        <div>
          <a class="inline-flex items-center gap-2.5 font-semibold no-underline" href={basePath}>
            <img src={`${basePath}markdim.svg`} width="29" height="29" alt="" />
            markdim
          </a>
          <p class="mt-2 max-w-prose text-sm leading-6 text-muted">Un espace de bureau pour lire, éditer et exporter vos documents Markdown.</p>
        </div>
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" aria-label="Liens complémentaires">
          <a class="text-link" href={repositoryUrl} target="_blank" rel="noreferrer">Code source <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <a class="text-link" href={downloadsUrl}>Téléchargements</a>
          <a class="text-link" href={`${repositoryUrl}/releases`} target="_blank" rel="noreferrer">Versions</a>
          <a class="text-link" href={`${repositoryUrl}/issues`} target="_blank" rel="noreferrer">Signaler un problème</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
