---
import '../styles/global.css';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import type { Locale, SitePage } from '../i18n';
import { localizePath, siteCopy } from '../i18n';

interface Props {
  lang?: Locale;
  page?: SitePage;
  title?: string;
  description?: string;
}

const {
  lang = 'en',
  page = 'home',
  title,
  description,
} = Astro.props;
const copy = siteCopy[lang].layout;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pageHref = (locale: Locale) => localizePath(basePath, locale, page);
const currentHref = pageHref(lang);
const englishHref = pageHref('en');
const frenchHref = pageHref('fr');
const homeHref = localizePath(basePath, lang, 'home');
const downloadsHref = localizePath(basePath, lang, 'downloads');
const privacyHref = localizePath(basePath, lang, 'privacy');
const canonical = new URL(currentHref, Astro.site);
const releaseUrl = 'https://github.com/numera11y/markdim/releases/latest';
const repositoryUrl = 'https://github.com/numera11y/markdim';
const pageCopy = siteCopy[lang][page];
const pageTitle = title ?? pageCopy.title;
const pageDescription = description ?? pageCopy.description;

const applicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'markdim',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, Linux',
  description: pageDescription,
  url: canonical.href,
  downloadUrl: releaseUrl,
  codeRepository: repositoryUrl,
  license: `${repositoryUrl}/blob/main/LICENSE`,
  inLanguage: lang === 'en' ? 'en-US' : 'fr-FR',
  isAccessibleForFree: true,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'markdim',
  url: new URL(homeHref, Astro.site).href,
  logo: new URL(`${basePath}markdim.svg`, Astro.site).href,
  sameAs: [repositoryUrl],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#141820" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}markdim.svg`} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={new URL(englishHref, Astro.site).href} />
    <link rel="alternate" hreflang="fr" href={new URL(frenchHref, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(englishHref, Astro.site).href} />
    <link rel="sitemap" type="application/xml" href={`${basePath}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'fr_FR'} />
    <meta property="og:site_name" content="markdim" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(`${basePath}og-card.png`, Astro.site).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${basePath}og-card.png`, Astro.site).href} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify([organizationSchema, applicationSchema])} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{copy.skipLink}</a>
    <header class="site-header">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 sm:px-8 lg:px-12">
        <a class="flex min-h-11 items-center gap-2 no-underline" href={homeHref} aria-label={copy.homeLink}>
          <img class="h-[30px] w-[30px] sm:h-[34px] sm:w-[34px]" src={`${basePath}markdim.svg`} width="34" height="34" alt="" />
          <span class="text-base font-semibold tracking-tight sm:text-lg">markdim</span>
        </a>
        <nav class="site-navigation flex items-center gap-3" aria-label={copy.primaryNav}>
          <div class="desktop-nav-links flex items-center gap-7 text-sm text-muted">
            <a class="no-underline hover:text-ink" href={`${homeHref}#features`}>{copy.features}</a>
            <a class="no-underline hover:text-ink" href={downloadsHref}>{copy.downloads}</a>
            <a class="no-underline hover:text-ink" href={`${homeHref}#faq`}>{copy.questions}</a>
          </div>
          <LanguageSwitch lang={lang} englishHref={englishHref} frenchHref={frenchHref} variant="desktop" />
          <details class="nav-menu">
            <summary class="menu-toggle" aria-label={copy.showNavigation}>
              <i class="ph ph-list" aria-hidden="true"></i>
            </summary>
            <div class="nav-links flex items-center gap-7 text-sm text-muted">
              <a class="no-underline hover:text-ink" href={`${homeHref}#features`}>{copy.features}</a>
              <a class="no-underline hover:text-ink" href={downloadsHref}>{copy.downloads}</a>
              <a class="no-underline hover:text-ink" href={`${homeHref}#faq`}>{copy.questions}</a>
              <LanguageSwitch lang={lang} englishHref={englishHref} frenchHref={frenchHref} variant="mobile" />
            </div>
          </details>
          <a class="header-download inline-flex min-h-11 items-center gap-1.5 whitespace-nowrap rounded-md bg-accent px-2 py-2 text-xs font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover sm:gap-2 sm:px-4 sm:text-sm" href={downloadsHref}>
            <span class="desktop-download-label">{copy.downloadFree}</span>
            <span class="mobile-download-label">{copy.mobileDownload}</span>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="border-t border-rule bg-paper">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-9 sm:grid-cols-[1fr_auto] sm:items-end sm:px-8 lg:px-12">
        <div>
          <a class="inline-flex items-center gap-2.5 font-semibold no-underline" href={homeHref}>
            <img src={`${basePath}markdim.svg`} width="29" height="29" alt="" />
            markdim
          </a>
          <p class="mt-2 max-w-prose text-sm leading-6 text-muted">{copy.footerSummary}</p>
        </div>
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" aria-label={copy.footerLinks}>
          <a class="text-link" href={repositoryUrl} target="_blank" rel="noreferrer">{copy.sourceCode} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <a class="text-link" href={`${repositoryUrl}/releases`} target="_blank" rel="noreferrer">{copy.releases}</a>
          <a class="text-link" href={`${repositoryUrl}/issues`} target="_blank" rel="noreferrer">{copy.reportIssue}</a>
          <a class="text-link" href={privacyHref}>{copy.privacy}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
