---
import SiteLayout from '../layouts/SiteLayout.astro';

const githubReleasesUrl = 'https://github.com/numera11y/markdim/releases';
---

<SiteLayout
  title="Télécharger markdim — toutes les versions"
  description="Téléchargez markdim pour Windows et Linux. Retrouvez toutes les versions publiées, bêtas comprises, avec leurs paquets et sommes SHA-256."
>
  <section class="px-5 pb-20 pt-12 sm:px-8 sm:pb-24 sm:pt-16 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <header class="grid gap-6 border-b border-rule pb-8 sm:pb-10 md:grid-cols-[1fr_0.8fr] md:items-end md:gap-16">
        <h1 class="display-title max-w-[14ch] text-4xl leading-tight sm:text-5xl lg:text-6xl">Versions et téléchargements.</h1>
        <p class="reading-measure text-base leading-7 text-muted sm:text-lg">
          Toutes les versions publiées de markdim, bêtas comprises. La liste est synchronisée avec GitHub à chaque visite; seuls les fichiers réellement attachés à une version sont proposés.
        </p>
      </header>

      <div class="flex flex-col gap-3 border-b border-rule py-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
          <label class="font-medium" for="platform-filter">Système</label>
          <select
            class="min-h-11 min-w-56 rounded-md border border-rule bg-page px-3 py-2 text-ink focus-visible:outline-3 focus-visible:outline-accent"
            id="platform-filter"
          >
            <option value="all">Tous les systèmes</option>
            <option value="windows">Windows</option>
            <option value="linux">Linux</option>
            <option value="macos">macOS</option>
          </select>
        </div>
        <p class="min-h-6 text-sm text-secondary" id="release-status" role="status" aria-live="polite">
          Chargement des versions publiées…
        </p>
      </div>

      <div class="release-ledger" id="release-list" aria-busy="true"></div>
      <noscript>
        <p class="mt-6 leading-7 text-muted">
          Activez JavaScript pour afficher la liste synchronisée des versions, ou consultez directement les
          <a class="text-link" href={githubReleasesUrl}>releases markdim sur GitHub</a>.
        </p>
      </noscript>

      <p class="reading-measure mt-8 text-sm leading-6 text-secondary">
        Les fichiers `.sha256` permettent de vérifier l’intégrité du téléchargement. Sur Debian ou Ubuntu, installez le paquet `.deb`; sur les autres distributions Linux, utilisez l’archive portable.
        <a class="text-link" href={githubReleasesUrl} target="_blank" rel="noreferrer">Voir les notes de version complètes sur GitHub <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>.
      </p>
    </div>
  </section>

  <script>
    type ReleaseAsset = {
      name: string;
      browser_download_url: string;
      size: number;
    };

    type PublishedRelease = {
      tag_name: string;
      name: string | null;
      draft: boolean;
      prerelease: boolean;
      published_at: string | null;
      html_url: string;
      assets: ReleaseAsset[];
    };

    type Platform = 'windows' | 'linux' | 'macos';

    const releasesEndpoint = 'https://api.github.com/repos/numera11y/markdim/releases';
    const filter = document.querySelector<HTMLSelectElement>('#platform-filter');
    const status = document.querySelector<HTMLParagraphElement>('#release-status');
    const list = document.querySelector<HTMLDivElement>('#release-list');
    const numberFormat = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 });
    let releases: PublishedRelease[] = [];

    function makeElement<K extends keyof HTMLElementTagNameMap>(
      tag: K,
      className = '',
      text = '',
    ): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text) node.textContent = text;
      return node;
    }

    function platformFor(name: string): Platform | null {
      const lowerName = name.toLowerCase();
      if (lowerName.endsWith('.sha256')) return null;
      if (lowerName.includes('windows') || /\.(exe|msi)$/.test(lowerName)) return 'windows';
      if (lowerName.includes('linux') || /\.(deb|appimage|rpm)$/.test(lowerName)) return 'linux';
      if (lowerName.includes('macos') || lowerName.includes('osx') || /\.(dmg|pkg)$/.test(lowerName)) return 'macos';
      return null;
    }

    function platformLabel(platform: Platform): string {
      return { windows: 'Windows', linux: 'Linux', macos: 'macOS' }[platform];
    }

    function assetLabel(asset: ReleaseAsset): string {
      const name = asset.name.toLowerCase();
      if (name.endsWith('.exe')) return 'Installateur Windows (.exe)';
      if (name.endsWith('.zip')) return 'Archive portable Windows (.zip)';
      if (name.endsWith('.deb')) {
        const architecture = name.includes('arm64') ? 'ARM64' : 'amd64';
        return `Paquet Debian / Ubuntu ${architecture} (.deb)`;
      }
      if (name.endsWith('.tar.gz')) {
        const architecture = name.includes('arm64') ? 'ARM64' : 'x64';
        return `Archive portable ${name.includes('linux') ? 'Linux' : 'macOS'} ${architecture} (.tar.gz)`;
      }
      if (name.endsWith('.dmg')) return 'Installateur macOS (.dmg)';
      if (name.endsWith('.pkg')) return 'Paquet macOS (.pkg)';
      if (name.endsWith('.appimage')) return 'Application Linux (.AppImage)';
      if (name.endsWith('.rpm')) return 'Paquet Linux (.rpm)';
      return asset.name;
    }

    function formatSize(bytes: number): string {
      return `${numberFormat.format(bytes / 1024 / 1024)} Mo`;
    }

    function formatDate(date: string | null): string {
      if (!date) return '';
      return new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(new Date(date));
    }

    function makeAssetRow(asset: ReleaseAsset, checksum: ReleaseAsset | undefined, version: string): HTMLLIElement {
      const row = makeElement('li', 'flex flex-col gap-1 border-t border-rule py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4');
      const download = makeElement('a', 'inline-flex min-h-11 items-center gap-2 font-medium text-accent underline decoration-transparent underline-offset-4 hover:decoration-current');
      download.href = asset.browser_download_url;
      download.setAttribute('aria-label', `Télécharger ${assetLabel(asset)} pour markdim ${version}`);
      download.append(makeElement('span', '', assetLabel(asset)));
      download.append(makeElement('span', 'text-xs text-secondary', formatSize(asset.size)));
      download.append(makeElement('i', 'ph ph-download-simple', ''));
      download.lastElementChild?.setAttribute('aria-hidden', 'true');
      row.append(download);

      if (checksum) {
        const checksumLink = makeElement('a', 'inline-flex min-h-11 items-center text-sm text-secondary underline decoration-rule underline-offset-4 hover:text-ink');
        checksumLink.href = checksum.browser_download_url;
        checksumLink.setAttribute('aria-label', `Somme SHA-256 pour ${assetLabel(asset)} ${version}`);
        checksumLink.textContent = 'SHA-256';
        row.append(checksumLink);
      }
      return row;
    }

    function makeRelease(release: PublishedRelease, selectedPlatform: string): HTMLElement {
      const article = makeElement('article', 'release-entry grid gap-6 border-t border-rule py-7 sm:py-8 md:grid-cols-[minmax(12rem,0.8fr)_2fr] md:gap-12');
      const heading = makeElement('div', 'flex flex-col items-start gap-3');
      const titleLine = makeElement('div', 'flex flex-wrap items-center gap-3');
      const title = makeElement('h2', 'text-2xl font-semibold tracking-tight sm:text-3xl', release.name || release.tag_name);
      const badge = makeElement(
        'span',
        'rounded-sm border border-rule px-2 py-1 text-xs font-medium text-secondary',
        release.prerelease ? 'Préversion' : 'Stable',
      );
      titleLine.append(title, badge);
      heading.append(titleLine);

      const date = formatDate(release.published_at);
      if (date) heading.append(makeElement('p', 'text-sm text-secondary', `Publiée le ${date}`));
      const notes = makeElement('a', 'inline-flex min-h-11 items-center gap-2 text-sm text-accent underline decoration-transparent underline-offset-4 hover:decoration-current', 'Notes de version');
      notes.href = release.html_url;
      notes.target = '_blank';
      notes.rel = 'noreferrer';
      notes.append(makeElement('i', 'ph ph-arrow-up-right', ''));
      notes.lastElementChild?.setAttribute('aria-hidden', 'true');
      heading.append(notes);
      article.append(heading);

      const packages = makeElement('div', 'grid gap-6');
      const checksumByName = new Map(release.assets.map(asset => [asset.name.toLowerCase(), asset]));
      const grouped = new Map<Platform, ReleaseAsset[]>();
      for (const asset of release.assets) {
        const platform = platformFor(asset.name);
        if (!platform) continue;
        const current = grouped.get(platform) || [];
        current.push(asset);
        grouped.set(platform, current);
      }

      for (const platform of ['windows', 'linux', 'macos'] as const) {
        if (selectedPlatform !== 'all' && selectedPlatform !== platform) continue;
        const assets = grouped.get(platform);
        if (!assets?.length) continue;
        const group = makeElement('section', 'min-w-0');
        group.setAttribute('aria-label', platformLabel(platform));
        group.append(makeElement('h3', 'mb-1 text-base font-semibold', platformLabel(platform)));
        const assetList = makeElement('ul', 'm-0 list-none p-0');
        for (const asset of assets) {
          const checksum = checksumByName.get(`${asset.name}.sha256`.toLowerCase());
          assetList.append(makeAssetRow(asset, checksum, release.tag_name));
        }
        group.append(assetList);
        packages.append(group);
      }

      if (!packages.childElementCount) {
        packages.append(makeElement('p', 'leading-6 text-muted', 'Aucun paquet pour ordinateur n’est joint à cette release. Consultez les notes de version.'));
      }
      article.append(packages);
      return article;
    }

    function renderReleases(): void {
      if (!list || !filter || !status) return;
      const selectedPlatform = filter.value;
      const visible = releases.filter(release => {
        if (selectedPlatform === 'all') return true;
        return release.assets.some(asset => platformFor(asset.name) === selectedPlatform);
      });
      list.replaceChildren(...visible.map(release => makeRelease(release, selectedPlatform)));
      list.setAttribute('aria-busy', 'false');

      if (!visible.length) {
        const message = selectedPlatform === 'all'
          ? 'Aucune version publiée pour le moment.'
          : `Aucune version publiée avec un téléchargement ${platformLabel(selectedPlatform as Platform)} pour le moment.`;
        list.append(makeElement('p', 'border-t border-rule py-6 leading-7 text-muted', message));
      }
      status.textContent = `${numberFormat.format(visible.length)} version${visible.length === 1 ? '' : 's'} affichée${visible.length === 1 ? '' : 's'}`;
    }

    async function loadReleases(): Promise<PublishedRelease[]> {
      const allReleases: PublishedRelease[] = [];
      let page = 1;
      while (true) {
        const response = await fetch(`${releasesEndpoint}?per_page=100&page=${page}`);
        if (!response.ok) throw new Error(`GitHub a répondu avec le statut ${response.status}.`);
        const batch = await response.json() as PublishedRelease[];
        if (!Array.isArray(batch)) throw new Error('La réponse GitHub ne contient pas une liste de releases.');
        allReleases.push(...batch.filter(release => !release.draft));
        if (batch.length < 100) break;
        page++;
      }
      return allReleases;
    }

    async function refreshReleases(): Promise<void> {
      if (!status || !list) return;
      status.replaceChildren(makeElement('span', '', 'Chargement des versions publiées…'));
      list.setAttribute('aria-busy', 'true');
      try {
        releases = await loadReleases();
        renderReleases();
      } catch {
        list.replaceChildren();
        list.setAttribute('aria-busy', 'false');
        status.textContent = 'Impossible de charger les versions pour le moment.';
        const fallback = makeElement('a', 'mt-3 inline-flex min-h-11 items-center gap-2 text-accent underline decoration-transparent underline-offset-4 hover:decoration-current', 'Ouvrir toutes les releases sur GitHub');
        fallback.href = 'https://github.com/numera11y/markdim/releases';
        fallback.target = '_blank';
        fallback.rel = 'noreferrer';
        list.append(fallback);
        const retry = makeElement('button', 'downloads-retry mt-3 inline-flex min-h-11 items-center text-accent underline decoration-transparent underline-offset-4 hover:decoration-current', 'Réessayer');
        retry.type = 'button';
        retry.addEventListener('click', () => void refreshReleases());
        list.append(retry);
      }
    }

    filter?.addEventListener('change', renderReleases);
    void refreshReleases();
  </script>
</SiteLayout>
