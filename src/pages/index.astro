---
import SiteLayout from '../layouts/SiteLayout.astro';

const releaseUrl = 'https://github.com/numera11y/markdim/releases/latest';
const repositoryUrl = 'https://github.com/numera11y/markdim';
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const faqs = [
  {
    question: 'markdim est-il gratuit ?',
    answer: 'Oui. markdim est open source sous licence MIT et les versions bêta sont téléchargeables gratuitement, sans compte ni abonnement.',
  },
  {
    question: 'Puis-je créer un fichier .md ou modifier un fichier existant ?',
    answer: 'Oui. Créez une note vierge, ouvrez un fichier .md ou .markdown, puis éditez le texte et enregistrez vos modifications.',
  },
  {
    question: 'Quels éléments Markdown l’aperçu prend-il en charge ?',
    answer: 'CommonMark et les extensions avancées de Markdig : titres, tableaux, listes imbriquées, tâches, liens, images et blocs de code colorés.',
  },
  {
    question: 'Puis-je exporter un document en PDF ?',
    answer: 'Oui. Exportez le document depuis le menu Fichier, sans le copier dans un autre outil.',
  },
  {
    question: 'Quelles versions sont disponibles ?',
    answer: 'Les versions bêta publiques sont actuellement disponibles pour Windows et Linux. Le projet cible aussi macOS; consultez les releases pour connaître les paquets publiés.',
  },
  {
    question: 'Mes fichiers restent-ils sur mon ordinateur ?',
    answer: 'Oui. markdim travaille avec vos fichiers locaux et n’ajoute ni compte en ligne, ni synchronisation cloud, ni télémétrie.',
  },
  {
    question: 'Puis-je ouvrir un fichier .md produit par OpenCode ?',
    answer: 'Oui. Les fichiers Markdown produits par OpenCode ou d’autres outils s’ouvrent comme les autres fichiers .md : aucun import spécial n’est nécessaire.',
  },
  {
    question: 'Comment agrandir le texte de la source ?',
    answer: 'Maintenez Ctrl et faites tourner la molette pour zoomer dans le texte de l’éditeur, sans modifier le fichier.',
  },
  {
    question: 'En quoi markdim diffère de MDViewer ?',
    answer: 'Les deux ouvrent, éditent et exportent des fichiers Markdown. MDViewer est distribué via le Microsoft Store pour Windows. markdim publie son code sous MIT, propose une bêta publique Linux en plus de Windows et permet de régler les panneaux bibliothèque, éditeur et aperçu.',
    link: 'https://apps.microsoft.com/detail/9NXLXLZ198SK',
    linkLabel: 'Voir la fiche officielle de MDViewer',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<SiteLayout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <section class="hero-stage px-5 pb-16 pt-10 sm:px-8 sm:pb-20 sm:pt-16 lg:px-12 lg:pt-20">
    <div class="mx-auto max-w-7xl">
      <div class="hero-copy mx-auto max-w-5xl text-center">
        <h1 class="display-title mx-auto max-w-[16ch] text-5xl leading-[0.98] sm:text-6xl lg:text-8xl">Lire. Écrire. Exporter.</h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-7 text-muted sm:text-xl">L’éditeur de bureau gratuit et open source pour créer, relire et modifier vos fichiers .md, puis les exporter en PDF.</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a class="inline-flex min-h-12 items-center gap-2 rounded-md bg-accent px-5 py-3 font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover" href={releaseUrl} target="_blank" rel="noreferrer">
            Télécharger gratuitement <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <a class="inline-flex min-h-12 items-center gap-2 px-4 py-3 font-medium text-ink underline decoration-transparent underline-offset-4 hover:decoration-current" href={`${basePath}#fonctionnalites`}>
            Voir les fonctionnalités <i class="ph ph-arrow-down" aria-hidden="true"></i>
          </a>
        </div>
        <p class="mt-5 text-sm text-secondary">Conçu pour Windows, macOS et Linux · bêta publique Windows et Linux</p>
        <ol class="workflow-route mt-8" aria-label="Parcours du Markdown">
          <li>Écrire</li>
          <li class="workflow-track" aria-hidden="true"></li>
          <li>Relire</li>
          <li class="workflow-track" aria-hidden="true"></li>
          <li>PDF</li>
        </ol>
      </div>

      <figure class="hero-capture mx-auto mt-10 max-w-7xl sm:mt-14">
        <div class="application-capture-frame">
          <a class="relative block cursor-zoom-in" href={`${basePath}images/markdim-workspace.webp`} target="_blank" rel="noreferrer" aria-label="Ouvrir la capture réelle de markdim en taille originale">
            <img
              class="block h-auto w-full"
              src={`${basePath}images/markdim-workspace.webp`}
              alt="Capture réelle de markdim en mode sombre : source Markdown à gauche et aperçu rendu à droite."
              width="1606"
              height="952"
              decoding="async"
              fetchpriority="high"
            />
            <span class="capture-zoom absolute bottom-3 right-3 inline-flex min-h-11 items-center gap-2 rounded-md border border-rule bg-page px-3 py-2 text-xs font-semibold text-accent">
              <i class="ph ph-magnifying-glass-plus text-base" aria-hidden="true"></i> Agrandir
            </span>
          </a>
        </div>
        <figcaption class="mt-3 flex items-start justify-center gap-2 text-xs leading-5 text-secondary"><i class="ph ph-info mt-0.5 text-accent" aria-hidden="true"></i> Capture réelle de l’application avec un document local d’exemple.</figcaption>
      </figure>
    </div>
  </section>

  <section id="fonctionnalites" class="scroll-mt-8 px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="feature-intro grid gap-6 pb-9 md:grid-cols-[1fr_1fr] md:gap-16 md:pb-12">
        <h2 class="display-title max-w-[15ch] text-4xl leading-tight sm:text-5xl">Un bureau pour tout votre Markdown.</h2>
        <p class="reading-measure text-lg leading-7 text-muted">Ouvrez un fichier ou un dossier, écrivez dans la source et gardez le rendu à portée de regard. Pas de compte à créer, pas de copier-coller entre outils.</p>
      </div>

      <div class="feature-list">
        <article class="feature-line grid gap-4 py-7 md:grid-cols-[2.5rem_0.8fr_1.2fr] md:items-start md:gap-7 md:py-9">
          <i class="ph ph-folder-open mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <h3 class="text-xl font-semibold">Ouvrez ce que vous avez déjà.</h3>
          <p class="max-w-2xl leading-7 text-muted">Ouvrez des fichiers .md et .markdown ou un dossier entier. Recherchez un document, retrouvez les fichiers récents et naviguez dans le plan des titres.</p>
        </article>
        <article class="feature-line grid gap-4 py-7 md:grid-cols-[2.5rem_0.8fr_1.2fr] md:items-start md:gap-7 md:py-9">
          <i class="ph ph-columns mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <h3 class="text-xl font-semibold">Lisez pendant que vous écrivez.</h3>
          <p class="max-w-2xl leading-7 text-muted">Modifiez le Markdown et voyez ses titres, listes, tableaux, liens, tâches et blocs de code prendre forme dans l’aperçu en direct.</p>
        </article>
        <article class="feature-line grid gap-4 py-7 md:grid-cols-[2.5rem_0.8fr_1.2fr] md:items-start md:gap-7 md:py-9">
          <i class="ph ph-tabs mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <h3 class="text-xl font-semibold">Gardez plusieurs notes sous la main.</h3>
          <p class="max-w-2xl leading-7 text-muted">Passez d’un onglet à l’autre, réordonnez vos documents, cherchez et remplacez du texte avec les raccourcis clavier.</p>
        </article>
        <article class="feature-line grid gap-4 py-7 md:grid-cols-[2.5rem_0.8fr_1.2fr] md:items-start md:gap-7 md:py-9">
          <i class="ph ph-file-pdf mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <h3 class="text-xl font-semibold">Un PDF, quand vous en avez besoin.</h3>
          <p class="max-w-2xl leading-7 text-muted">Exportez votre document depuis le même bureau, sans en déplacer le contenu dans un convertisseur web.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-rule bg-page px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <h2 class="display-title max-w-[14ch] text-4xl leading-tight sm:text-5xl">Votre bureau, à votre façon.</h2>
      <div class="divide-y divide-rule border-y border-rule">
        <article class="grid gap-2 py-5 sm:grid-cols-[0.7fr_1.3fr] sm:gap-8">
          <h3 class="font-semibold">Réglez l’espace.</h3>
          <p class="leading-6 text-muted">Affichez ou repliez la bibliothèque, l’éditeur et l’aperçu. Redimensionnez-les et retrouvez leur disposition à la prochaine ouverture.</p>
        </article>
        <article class="grid gap-2 py-5 sm:grid-cols-[0.7fr_1.3fr] sm:gap-8">
          <h3 class="font-semibold">Ajustez le texte.</h3>
          <p class="leading-6 text-muted">Maintenez <kbd class="rounded border border-rule bg-wash px-1.5 py-0.5 text-xs text-ink">Ctrl</kbd> et tournez la molette pour zoomer dans l’éditeur. Les espaces et fins de ligne peuvent aussi être affichés.</p>
        </article>
        <article class="grid gap-2 py-5 sm:grid-cols-[0.7fr_1.3fr] sm:gap-8">
          <h3 class="font-semibold">Choisissez l’apparence.</h3>
          <p class="leading-6 text-muted">Passez du thème clair au thème sombre. Votre choix est conservé pour vos prochaines sessions.</p>
        </article>
        <article class="grid gap-2 py-5 sm:grid-cols-[0.7fr_1.3fr] sm:gap-8">
          <h3 class="font-semibold">Ouvrez plus vite.</h3>
          <p class="leading-6 text-muted">Sous Windows, ajoutez markdim au menu « Ouvrir avec » pour vos fichiers Markdown.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <h2 class="display-title max-w-[14ch] text-4xl leading-tight sm:text-5xl">Vos fichiers restent à vous.</h2>
        <p class="reading-measure mt-5 text-lg leading-7 text-muted">markdim travaille avec vos fichiers locaux. Sans compte, sans synchronisation cloud et sans télémétrie. Son code source est public sous licence MIT.</p>
      </div>
      <a class="inline-flex min-h-11 items-center gap-2 font-medium text-accent underline decoration-transparent underline-offset-4 hover:decoration-current" href={repositoryUrl} target="_blank" rel="noreferrer">Voir le code source <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>

  <section id="compatibilite" class="px-5 pb-16 sm:px-8 sm:pb-20 lg:px-12">
    <div class="download-panel mx-auto grid max-w-7xl gap-8 rounded-xl px-6 py-9 sm:px-10 sm:py-12 md:grid-cols-[1fr_auto] md:items-center lg:px-14">
      <div>
        <h2 class="display-title max-w-[16ch] text-3xl leading-tight sm:text-4xl">Téléchargez markdim.</h2>
        <p class="mt-4 max-w-[58ch] leading-7 text-muted">Éditeur gratuit et open source. Bêtas publiques pour Windows et Linux; le projet cible aussi macOS. Vérifiez les paquets et notes de version avant l’installation.</p>
      </div>
      <a class="inline-flex min-h-12 items-center justify-center gap-2 self-start rounded-md bg-accent px-5 py-3 font-semibold text-on-accent no-underline transition-colors hover:bg-accent-hover md:self-center" href={releaseUrl} target="_blank" rel="noreferrer">Télécharger gratuitement <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>

  <section id="questions" class="scroll-mt-8 border-t border-rule bg-page px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-9 md:grid-cols-[0.7fr_1.3fr] md:gap-16">
      <h2 class="display-title max-w-[11ch] text-4xl leading-tight sm:text-5xl">Questions fréquentes.</h2>
      <div>
        {faqs.map(({ question, answer, link, linkLabel }) => (
          <details class="faq-item group">
            <summary class="text-base font-medium sm:text-lg">{question}</summary>
            <p class="faq-answer">{answer}</p>
            {link && <p class="faq-answer -mt-4"><a class="text-link" href={link} target="_blank" rel="noreferrer">{linkLabel} <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></p>}
          </details>
        ))}
        <p class="mt-6 text-sm leading-6 text-secondary">Un doute sur une version ou un problème rencontré ? <a class="text-link" href={`${repositoryUrl}/issues`} target="_blank" rel="noreferrer">Écrivez-nous sur GitHub <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>.</p>
      </div>
    </div>
  </section>
</SiteLayout>
