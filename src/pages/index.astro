---
import SiteLayout from '../layouts/SiteLayout.astro';

const releaseUrl = 'https://github.com/numera11y/Marginalia/releases/latest';
const repositoryUrl = 'https://github.com/numera11y/Marginalia';
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const faqs = [
  {
    question: 'Puis-je ouvrir un fichier .md produit par OpenCode ?',
    answer: 'Oui. Ouvrez un fichier .md ou .markdown comme n’importe quel autre fichier. Pas de conversion ni d’import spécial : cela fonctionne aussi avec les sorties d’autres agents IA.',
  },
  {
    question: 'Puis-je modifier le texte généré par l’agent ?',
    answer: 'Oui. Modifiez directement la source Markdown, relisez le rendu dans l’aperçu en direct, puis enregistrez vos changements.',
  },
  {
    question: 'Pourquoi utiliser Marginalia si mon IDE affiche déjà les .md ?',
    answer: 'Gardez votre IDE pour le code. Marginalia rassemble autour du document la bibliothèque, l’édition de la source, l’aperçu en direct et l’export PDF.',
  },
  {
    question: 'Marginalia est-il gratuit ?',
    answer: 'Oui. Marginalia est open source sous licence MIT et les versions bêta sont téléchargeables gratuitement. Pas de compte ni d’abonnement.',
  },
  {
    question: 'Puis-je exporter le document en PDF ?',
    answer: 'Oui. Exportez le document relu en PDF depuis le menu Fichier, sans le copier dans un autre outil.',
  },
  {
    question: 'Quelles versions puis-je télécharger ?',
    answer: 'Les préversions publiques sont actuellement disponibles pour Windows et Linux. Le projet vise aussi macOS; consultez les releases pour les paquets publiés et leurs notes de version.',
  },
  {
    question: 'Mes fichiers sont-ils envoyés dans le cloud ?',
    answer: 'Non. Marginalia ouvre les fichiers depuis votre ordinateur, sans compte en ligne, synchronisation cloud ni télémétrie.',
  },
  {
    question: 'Quel Markdown l’aperçu prend-il en charge ?',
    answer: 'CommonMark et les extensions avancées de Markdig : tableaux, listes imbriquées, tâches, liens, images et blocs de code colorés.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<SiteLayout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <section class="px-5 pb-16 pt-8 sm:px-8 sm:pb-20 sm:pt-12 lg:px-12 lg:pt-14">
    <div class="mx-auto max-w-7xl">
      <div class="hero-folio grid overflow-hidden rounded-md border border-rule lg:min-h-[600px] lg:grid-cols-[0.76fr_1.24fr]">
        <div class="hero-copy flex flex-col justify-between px-7 py-9 sm:px-11 sm:py-12 lg:px-12 lg:py-14">
          <div>
            <h1 class="editorial-title max-w-[15ch] text-5xl leading-[1.02] sm:text-6xl lg:text-[4.15rem]">Du .md produit par l’IA au PDF prêt à partager.</h1>
            <p class="reading-measure mt-6 text-lg leading-7 text-muted">Ouvrez le fichier produit par OpenCode ou un autre agent, modifiez sa source avec l’aperçu en direct et exportez-le en PDF. Marginalia est gratuit et open source.</p>
          </div>
          <div class="mt-9">
            <div class="flex flex-wrap items-center gap-3">
              <a class="inline-flex min-h-12 items-center gap-2 rounded-md bg-accent px-5 py-3 font-semibold text-white no-underline transition-colors hover:bg-[#1f4f9d]" href={releaseUrl} target="_blank" rel="noreferrer">
                Télécharger gratuitement <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
              </a>
              <a class="inline-flex min-h-12 items-center gap-2 px-3 py-3 font-medium text-accent underline decoration-transparent underline-offset-4 hover:decoration-current" href={`${basePath}#fonctionnalites`}>
                Voir le parcours <i class="ph ph-arrow-down" aria-hidden="true"></i>
              </a>
            </div>
            <p class="mt-5 text-sm leading-6 text-secondary">Bêta publique Windows et Linux · open source MIT · fichiers locaux</p>
          </div>
        </div>

        <div class="hero-demonstration flex items-center px-5 py-6 sm:px-9 sm:py-9 lg:px-10 lg:py-12">
          <figure class="w-full">
            <div class="application-capture-frame">
              <a class="relative block cursor-zoom-in" href={`${basePath}images/marginalia-workspace.webp`} target="_blank" rel="noreferrer" aria-label="Ouvrir la capture réelle de Marginalia en taille originale">
                <img
                  class="block h-auto w-full"
                  src={`${basePath}images/marginalia-workspace.webp`}
                  alt="Capture réelle de Marginalia montrant un document Markdown dans l’éditeur et son aperçu en direct, avec une liste, une citation et un tableau."
                  width="1606"
                  height="952"
                  decoding="async"
                  fetchpriority="high"
                />
                <span class="capture-zoom absolute bottom-3 right-3 inline-flex min-h-11 items-center gap-2 rounded-md border border-rule bg-white px-3 py-2 text-xs font-semibold text-accent">
                  <i class="ph ph-magnifying-glass-plus text-base" aria-hidden="true"></i> Agrandir
                </span>
              </a>
            </div>
            <figcaption class="mt-3 flex items-start gap-2 text-xs leading-5 text-secondary"><i class="ph ph-info mt-0.5 text-accent" aria-hidden="true"></i> Capture de l’application avec un document local d’exemple.</figcaption>
          </figure>
        </div>
      </div>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-sm text-secondary">
        <span>Ouvrir une sortie .md d’OpenCode</span>
        <span>Modifier la source et vérifier le rendu</span>
        <span>Exporter le document en PDF</span>
      </div>
    </div>
  </section>

  <section id="fonctionnalites" class="scroll-mt-8 px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 border-b border-rule pb-10 md:grid-cols-[minmax(12rem,0.7fr)_1.3fr] md:gap-16">
        <div><h2 class="editorial-title max-w-[17ch] text-4xl leading-tight sm:text-5xl">Votre agent a fini. Le document, pas encore.</h2></div>
        <div><p class="reading-measure text-lg leading-7 text-muted">Un IDE peut afficher la sortie. Marginalia s’occupe de la suite : modifier le .md, voir le rendu pendant la relecture, puis exporter un PDF. Tout se passe dans un outil pensé pour le document, sur votre ordinateur.</p></div>
      </div>

      <article class="story-panel grid gap-8 border-b border-rule py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-folder-open mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Ouvrez la sortie de votre agent</h3><p class="mt-3 max-w-sm leading-7 text-muted">Les fichiers .md et .markdown d’OpenCode, d’autres agents IA ou de vos projets existants s’ouvrent directement. Chargez un fichier ou un dossier, filtrez la bibliothèque et retrouvez un titre dans le plan du document.</p><p class="mt-3 text-sm leading-6 text-secondary"><kbd class="rounded border border-rule bg-white px-1.5 py-0.5 text-xs">Ctrl+O</kbd> ouvre un fichier; <kbd class="rounded border border-rule bg-white px-1.5 py-0.5 text-xs">Ctrl+Maj+O</kbd> ouvre un dossier.</p></div>
        </div>
        <div class="flex flex-col justify-center border-y border-rule bg-white px-5 py-4 sm:flex-row sm:items-center sm:gap-5 sm:px-7">
          <div class="min-w-40 border-b border-rule pb-3 sm:border-b-0 sm:border-r sm:pb-0 sm:pr-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-secondary">Sorties Markdown</p>
            <p class="mt-2 font-semibold">Documents du projet</p>
          </div>
          <div class="grid flex-1 gap-1 py-2 sm:grid-cols-2">
            <span class="flex items-center gap-2 py-2 text-sm"><i class="ph ph-file-text text-lg text-accent" aria-hidden="true"></i> synthese.md</span>
            <span class="flex items-center gap-2 py-2 text-sm"><i class="ph ph-file-text text-lg text-secondary" aria-hidden="true"></i> plan-projet.md</span>
            <span class="flex items-center gap-2 py-2 text-sm"><i class="ph ph-file-text text-lg text-secondary" aria-hidden="true"></i> compte-rendu.md</span>
            <span class="flex items-center gap-2 py-2 text-sm text-secondary"><i class="ph ph-magnifying-glass text-lg" aria-hidden="true"></i> Filtrer les documents</span>
          </div>
        </div>
      </article>

      <article class="story-panel grid gap-8 border-b border-rule py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-columns mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Relisez et modifiez la source</h3><p class="mt-3 max-w-sm leading-7 text-muted">L’éditeur garde le Markdown modifiable; l’aperçu montre aussitôt les titres, tableaux, listes, tâches, liens et blocs de code mis en forme. Corrigez la sortie de l’agent avant de l’envoyer.</p></div>
        </div>
        <div class="grid gap-px border border-rule bg-rule sm:grid-cols-2">
          <div class="bg-white p-5 sm:p-7">
            <p class="text-xs font-semibold tracking-wider text-secondary">VOUS ÉCRIVEZ</p>
            <pre class="mt-4 overflow-x-auto text-sm leading-7 text-muted"><code>## Décisions&#10;&#10;- Garder les notes en Markdown&#10;- [ ] Préparer le PDF</code></pre>
          </div>
          <div class="bg-white p-5 sm:p-7">
            <p class="text-xs font-semibold tracking-wider text-secondary">VOUS RELISEZ</p>
            <h4 class="mt-4 text-lg font-semibold">Décisions</h4>
            <ul class="mt-3 list-inside list-disc text-sm leading-7 text-muted"><li>Garder les notes en Markdown</li><li>Préparer le PDF</li></ul>
          </div>
        </div>
      </article>

      <article class="story-panel grid gap-8 border-b border-rule py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-files mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Continuez dans un seul bureau</h3><p class="mt-3 max-w-sm leading-7 text-muted">Gardez plusieurs fichiers ouverts, réordonnez les onglets, créez une note ou cherchez et remplacez du texte sans perdre le fil de la sortie de l’agent.</p></div>
        </div>
        <div class="border border-rule bg-white">
          <div class="flex flex-wrap items-center gap-1 border-b border-rule bg-wash px-3 pt-2 text-sm">
            <span class="border-b-2 border-accent bg-white px-3 py-3 font-medium">synthese.md</span>
            <span class="px-3 py-3 text-muted">plan-projet.md</span>
            <span class="px-3 py-3 text-muted">compte-rendu.md</span>
          </div>
          <div class="flex flex-wrap gap-x-7 gap-y-2 px-5 py-4 text-sm text-muted">
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Tab</kbd> Document suivant</span>
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">K</kbd> Rechercher</span>
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">H</kbd> Remplacer</span>
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">S</kbd> Enregistrer</span>
          </div>
        </div>
      </article>

      <article class="story-panel grid gap-8 py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-file-pdf mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Terminez par un PDF</h3><p class="mt-3 max-w-sm leading-7 text-muted">Quand la sortie de l’agent est relue et corrigée, exportez une version prête à transmettre depuis le même bureau.</p></div>
        </div>
        <div class="grid items-center gap-5 border-y border-rule bg-white px-5 py-5 sm:grid-cols-[1fr_auto] sm:px-8">
          <div><p class="text-xs font-semibold tracking-wider text-secondary">DANS LE MENU FICHIER</p><p class="mt-2 text-lg font-medium">Exporter en PDF…</p><p class="mt-1 text-sm text-muted">Raccourci clavier : Ctrl + Maj + E</p></div>
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-wash text-2xl text-accent" aria-hidden="true"><i class="ph ph-file-pdf"></i></span>
        </div>
      </article>
    </div>
  </section>

  <section class="border-y border-rule bg-white px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <div><h2 class="editorial-title max-w-[14ch] text-4xl leading-tight sm:text-5xl">Un bureau réglé pour votre façon de lire.</h2></div>
        <div class="grid gap-0 sm:grid-cols-2 sm:gap-x-10">
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Choisissez vos panneaux</h3><p class="mt-2 leading-6 text-muted">Affichez ou repliez la bibliothèque, l’éditeur et l’aperçu. Redimensionnez-les selon le document ouvert.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Reprenez où vous étiez</h3><p class="mt-2 leading-6 text-muted">Marginalia mémorise les dimensions et la disposition que vous préférez.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Lisez en clair ou en sombre</h3><p class="mt-2 leading-6 text-muted">Choisissez un thème clair ou sombre et ajustez la taille du texte de l’éditeur.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Ouvrez vos fichiers facilement</h3><p class="mt-2 leading-6 text-muted">Sur Windows, ajoutez Marginalia au menu « Ouvrir avec » pour les fichiers Markdown.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Suivez le texte avec précision</h3><p class="mt-2 leading-6 text-muted">L’éditeur affiche les numéros de ligne et permet de rendre visibles espaces, tabulations et fins de ligne. Dans l’aperçu, les blocs de code sont colorés et numérotés.</p></div>
      </div>
    </div>
  </section>

  <section id="compatibilite" class="scroll-mt-8 px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <div><h2 class="editorial-title max-w-[12ch] text-4xl leading-tight sm:text-5xl">Vos fichiers restent chez vous.</h2></div>
        <div>
          <p class="reading-measure text-lg leading-7 text-muted">Aucun compte à créer ni texte à envoyer à un service cloud : ouvrez le fichier produit par l’agent depuis son emplacement habituel, puis gardez vos modifications en local.</p>
          <p class="reading-measure mt-4 leading-7 text-muted">Le projet vise Windows, macOS et Linux. Les préversions gratuites à télécharger aujourd’hui sont celles de Windows et Linux; les notes de version précisent les systèmes et paquets publiés.</p>
          <a class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-accent underline decoration-transparent underline-offset-4 hover:decoration-current" href={releaseUrl} target="_blank" rel="noreferrer">Voir les versions disponibles <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 pb-16 sm:px-8 sm:pb-20 lg:px-12">
    <div class="download-panel mx-auto grid max-w-7xl gap-8 rounded-md px-6 py-9 sm:px-10 sm:py-12 md:grid-cols-[1fr_auto] md:items-center lg:px-14">
      <div><p class="mb-3 text-sm font-medium text-[#c7d2fe]">Gratuit · open source · MIT</p><h2 class="editorial-title max-w-[17ch] text-3xl leading-tight sm:text-4xl">Récupérez la sortie de l’agent. Faites-en votre document.</h2><p class="mt-4 max-w-[58ch] leading-7 text-[#e1e5ec]">Téléchargez les préversions Windows ou Linux depuis les releases officielles. Vérifiez les fichiers et les notes de version avant l’installation.</p></div>
      <a class="inline-flex min-h-12 items-center justify-center gap-2 self-start rounded-md bg-white px-5 py-3 font-semibold text-ink no-underline transition-colors hover:bg-[#e6eaf1] md:self-center" href={releaseUrl} target="_blank" rel="noreferrer">Télécharger gratuitement <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>

  <section id="questions" class="scroll-mt-8 bg-white px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-9 md:grid-cols-[0.7fr_1.3fr] md:gap-16">
      <div><h2 class="editorial-title max-w-[11ch] text-4xl leading-tight sm:text-5xl">Questions fréquentes.</h2></div>
      <div>
        {faqs.map(({ question, answer }) => (
          <details class="faq-item group">
            <summary class="text-base font-medium sm:text-lg">{question}</summary>
            <p class="faq-answer">{answer}</p>
          </details>
        ))}
        <p class="mt-6 text-sm leading-6 text-muted">Un doute sur une version ou un problème rencontré ? <a class="text-link" href={`${repositoryUrl}/issues`} target="_blank" rel="noreferrer">Écrivez-nous sur GitHub <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>.</p>
      </div>
    </div>
  </section>
</SiteLayout>
