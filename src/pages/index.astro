---
import SiteLayout from '../layouts/SiteLayout.astro';

const releaseUrl = 'https://github.com/numera11y/Marginalia/releases/latest';
const repositoryUrl = 'https://github.com/numera11y/Marginalia';
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const faqs = [
  {
    question: 'Marginalia modifie-t-il mes fichiers Markdown ?',
    answer: 'Marginalia ouvre les fichiers Markdown présents sur votre ordinateur. Vous choisissez quand enregistrer les modifications et où exporter votre PDF.',
  },
  {
    question: 'Quelles versions puis-je télécharger aujourd’hui ?',
    answer: 'Les préversions publiques sont actuellement disponibles pour Windows et Linux. Le projet est conçu pour Windows, macOS et Linux; consultez les releases pour voir les paquets publiés et leurs notes de version.',
  },
  {
    question: 'Quels éléments Markdown puis-je relire ?',
    answer: 'L’aperçu prend en charge CommonMark et les extensions avancées de Markdig, dont tableaux, listes imbriquées, tâches, liens, images et blocs de code colorés.',
  },
  {
    question: 'Puis-je exporter un document en PDF ?',
    answer: 'Oui. L’export PDF est intégré à l’application et fonctionne depuis le même espace que l’éditeur et l’aperçu.',
  },
  {
    question: 'Marginalia envoie-t-il mes documents dans le cloud ?',
    answer: 'Non. Les documents s’ouvrent depuis vos fichiers locaux; Marginalia ne les synchronise pas vers un service cloud et n’ajoute ni compte en ligne ni télémétrie.',
  },
  {
    question: 'Marginalia est-il un logiciel libre ?',
    answer: 'Oui. Le code source est publié sous licence MIT sur GitHub.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<SiteLayout>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <section class="px-5 pb-16 pt-8 sm:px-8 sm:pb-20 sm:pt-12 lg:px-12 lg:pt-14">
    <div class="mx-auto max-w-7xl">
      <div class="hero-folio grid overflow-hidden rounded-md border border-rule lg:min-h-[600px] lg:grid-cols-[0.76fr_1.24fr]">
        <div class="hero-copy flex flex-col justify-between px-7 py-9 sm:px-11 sm:py-12 lg:px-12 lg:py-14">
          <div>
            <p class="mb-7 inline-flex items-center gap-2 text-sm font-medium text-muted">
              <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
              La table de travail du Markdown
            </p>
            <h1 class="editorial-title max-w-[12ch] text-5xl leading-[1.02] sm:text-6xl lg:text-[4.15rem]">Gardez le fil de vos idées.</h1>
            <p class="reading-measure mt-6 text-lg leading-7 text-muted">Retrouvez vos fichiers Markdown, corrigez la source et relisez le rendu dans le même espace de bureau.</p>
          </div>
          <div class="mt-9">
            <div class="flex flex-wrap items-center gap-3">
              <a class="inline-flex min-h-12 items-center gap-2 rounded-md bg-accent px-5 py-3 font-semibold text-white no-underline transition-colors hover:bg-[#1f4f9d]" href={releaseUrl} target="_blank" rel="noreferrer">
                Télécharger la bêta <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
              </a>
              <a class="inline-flex min-h-12 items-center gap-2 px-3 py-3 font-medium text-accent underline decoration-transparent underline-offset-4 hover:decoration-current" href={`${basePath}#fonctionnalites`}>
                Découvrir les fonctions <i class="ph ph-arrow-down" aria-hidden="true"></i>
              </a>
            </div>
            <p class="mt-5 text-sm leading-6 text-secondary">Préversions publiques Windows et Linux · fichiers conservés sur votre ordinateur</p>
          </div>
        </div>

        <div class="hero-demonstration flex items-center px-5 py-6 sm:px-9 sm:py-9 lg:px-10 lg:py-12">
          <div class="w-full">
            <div class="demo-window">
              <div class="flex h-11 items-center justify-between border-b border-rule bg-white px-4 text-xs text-muted">
                <span class="inline-flex items-center gap-2 font-medium text-ink"><i class="ph ph-folder-open text-base text-accent" aria-hidden="true"></i> Notes de lecture</span>
                <span class="rounded-sm bg-wash px-2 py-1">Exemple</span>
              </div>
              <div class="flex h-10 items-center gap-1 overflow-hidden border-b border-rule bg-white px-3 text-xs text-muted">
                <span class="whitespace-nowrap border-b-2 border-accent px-3 py-3 text-ink">Introduction.md</span>
                <span class="whitespace-nowrap px-3 py-3">Projet.md</span>
                <span class="whitespace-nowrap px-3 py-3">Références.md</span>
              </div>
              <div class="demo-panes grid min-h-[310px] grid-cols-2">
                <div class="demo-pane demo-code border-r border-rule px-4 py-5 text-[11px] leading-[1.9] sm:px-5 sm:text-xs">
                  <p class="mb-3 font-sans text-[10px] font-semibold tracking-[0.12em] text-secondary">SOURCE MARKDOWN</p>
                  <span class="text-accent">#</span> Lire, écrire, relire<br />
                  <br />
                  Une idée prend forme dans son propre fichier.<br />
                  <br />
                  <span class="text-accent">##</span> Garder le fil<br />
                  <br />
                  - Vos documents, réunis<br />
                  - Le rendu, visible en direct<br />
                  <br />
                  **Prêt à partager ?**
                </div>
                <div class="demo-pane demo-preview px-4 py-5 text-xs leading-6 text-muted sm:px-5 sm:text-sm">
                  <p class="mb-3 text-[10px] font-semibold tracking-[0.12em] text-secondary">APERÇU EN DIRECT</p>
                  <h3 class="mb-2 text-xl text-ink sm:text-2xl">Lire, écrire, relire</h3>
                  <p>Une idée prend forme dans son propre fichier.</p>
                  <h4 class="mb-1 mt-4 font-semibold text-ink">Garder le fil</h4>
                  <ul class="list-inside list-disc">
                    <li>Vos documents, réunis</li>
                    <li>Le rendu, visible en direct</li>
                  </ul>
                  <p class="mt-3 font-semibold text-ink">Prêt à partager ?</p>
                </div>
              </div>
              <div class="flex items-center justify-between border-t border-rule bg-white px-4 py-2.5 text-[10px] text-secondary sm:text-xs">
                <span>Introduction.md</span><span>Ligne 1, colonne 1</span><span>Markdown</span>
              </div>
            </div>
            <p class="mt-3 flex items-start gap-2 text-xs leading-5 text-secondary"><i class="ph ph-info mt-0.5 text-accent" aria-hidden="true"></i> Aperçu reconstitué à partir des fonctions de l’application; le document affiché est un exemple.</p>
          </div>
        </div>
      </div>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 text-sm text-secondary">
        <span>Ouvrir un fichier ou un dossier complet</span>
        <span>Éditer et relire côte à côte</span>
        <span>Exporter en PDF quand c’est prêt</span>
      </div>
    </div>
  </section>

  <section id="fonctionnalites" class="scroll-mt-8 px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 border-b border-rule pb-10 md:grid-cols-[minmax(12rem,0.7fr)_1.3fr] md:gap-16">
        <p class="text-sm font-semibold text-accent">Un espace, plusieurs façons d’avancer</p>
        <div>
          <h2 class="editorial-title max-w-[17ch] text-4xl leading-tight sm:text-5xl">Du dossier au document prêt à partager.</h2>
          <p class="reading-measure mt-5 text-lg leading-7 text-muted">Marginalia rassemble les gestes que l’on répète quand on travaille en Markdown — sans déplacer vos fichiers vers un service en ligne.</p>
        </div>
      </div>

      <article class="story-panel grid gap-8 border-b border-rule py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-folder-open mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Retrouvez vos notes</h3><p class="mt-3 max-w-sm leading-7 text-muted">Ouvrez un fichier Markdown ou un dossier entier. Recherchez dans la bibliothèque, repérez vos documents récents et revenez au bon titre grâce au plan du document.</p><p class="mt-3 text-sm leading-6 text-secondary"><kbd class="rounded border border-rule bg-white px-1.5 py-0.5 text-xs">Ctrl+O</kbd> ouvre un fichier; <kbd class="rounded border border-rule bg-white px-1.5 py-0.5 text-xs">Ctrl+Maj+O</kbd> ouvre un dossier.</p></div>
        </div>
        <div class="flex flex-col justify-center border-y border-rule bg-white px-5 py-4 sm:flex-row sm:items-center sm:gap-5 sm:px-7">
          <div class="min-w-40 border-b border-rule pb-3 sm:border-b-0 sm:border-r sm:pb-0 sm:pr-5">
            <p class="text-xs font-semibold uppercase tracking-wider text-secondary">Bibliothèque</p>
            <p class="mt-2 font-semibold">Notes de lecture</p>
          </div>
          <div class="grid flex-1 gap-1 py-2 sm:grid-cols-2">
            <span class="flex items-center gap-2 py-2 text-sm"><i class="ph ph-file-text text-lg text-accent" aria-hidden="true"></i> Introduction.md</span>
            <span class="flex items-center gap-2 py-2 text-sm"><i class="ph ph-file-text text-lg text-secondary" aria-hidden="true"></i> Projet.md</span>
            <span class="flex items-center gap-2 py-2 text-sm"><i class="ph ph-file-text text-lg text-secondary" aria-hidden="true"></i> Références.md</span>
            <span class="flex items-center gap-2 py-2 text-sm text-secondary"><i class="ph ph-magnifying-glass text-lg" aria-hidden="true"></i> Filtrer les documents</span>
          </div>
        </div>
      </article>

      <article class="story-panel grid gap-8 border-b border-rule py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-columns mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Écrivez, puis voyez le résultat</h3><p class="mt-3 max-w-sm leading-7 text-muted">La source Markdown et son aperçu restent côte à côte. Les titres, tableaux, liens, listes imbriquées, tâches et blocs de code se lisent sans quitter le document.</p></div>
        </div>
        <div class="grid gap-px border border-rule bg-rule sm:grid-cols-2">
          <div class="bg-white p-5 sm:p-7">
            <p class="text-xs font-semibold tracking-wider text-secondary">VOUS ÉCRIVEZ</p>
            <pre class="mt-4 overflow-x-auto text-sm leading-7 text-muted"><code>## Pour continuer&#10;&#10;- Relire les notes&#10;- [ ] Exporter le PDF</code></pre>
          </div>
          <div class="bg-white p-5 sm:p-7">
            <p class="text-xs font-semibold tracking-wider text-secondary">VOUS RELISEZ</p>
            <h4 class="mt-4 text-lg font-semibold">Pour continuer</h4>
            <ul class="mt-3 list-inside list-disc text-sm leading-7 text-muted"><li>Relire les notes</li><li>Exporter le PDF</li></ul>
          </div>
        </div>
      </article>

      <article class="story-panel grid gap-8 border-b border-rule py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-files mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Gardez plusieurs documents sous la main</h3><p class="mt-3 max-w-sm leading-7 text-muted">Passez d’un onglet à l’autre, changez leur ordre et utilisez les raccourcis clavier pour rester dans votre travail. Créez un document vierge, enregistrez-le ailleurs ou recherchez et remplacez du texte.</p></div>
        </div>
        <div class="border border-rule bg-white">
          <div class="flex flex-wrap items-center gap-1 border-b border-rule bg-wash px-3 pt-2 text-sm">
            <span class="border-b-2 border-accent bg-white px-3 py-3 font-medium">Introduction.md</span>
            <span class="px-3 py-3 text-muted">Projet.md</span>
            <span class="px-3 py-3 text-muted">Références.md</span>
          </div>
          <div class="flex flex-wrap gap-x-7 gap-y-2 px-5 py-4 text-sm text-muted">
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Tab</kbd> Document suivant</span>
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">K</kbd> Rechercher</span>
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">H</kbd> Remplacer</span>
            <span><kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">Ctrl</kbd> + <kbd class="rounded border border-rule bg-paper px-1.5 py-0.5 text-xs">S</kbd> Enregistrer</span>
          </div>
        </div>
      </article>

      <article class="story-panel grid gap-8 py-11 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-14">
        <div class="flex items-start gap-4">
          <i class="ph ph-file-pdf mt-1 text-2xl text-accent" aria-hidden="true"></i>
          <div><h3 class="text-xl font-semibold">Un PDF, au moment utile</h3><p class="mt-3 max-w-sm leading-7 text-muted">Exportez le document depuis le même bureau. Pas besoin de copier le texte dans un autre outil pour obtenir une version à partager.</p></div>
        </div>
        <div class="grid items-center gap-5 border-y border-rule bg-white px-5 py-5 sm:grid-cols-[1fr_auto] sm:px-8">
          <div><p class="text-xs font-semibold tracking-wider text-secondary">DANS LE MENU FICHIER</p><p class="mt-2 text-lg font-medium">Exporter en PDF…</p><p class="mt-1 text-sm text-muted">Raccourci clavier : Ctrl + Maj + E</p></div>
          <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-wash text-2xl text-accent" aria-hidden="true"><i class="ph ph-file-pdf"></i></span>
        </div>
      </article>
    </div>
  </section>

  <section class="border-y border-rule bg-white px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <div><p class="mb-4 text-sm font-semibold text-accent">Un bureau à votre mesure</p><h2 class="editorial-title max-w-[14ch] text-4xl leading-tight sm:text-5xl">Votre espace suit votre façon de lire.</h2></div>
        <div class="grid gap-0 sm:grid-cols-2 sm:gap-x-10">
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Choisissez vos panneaux</h3><p class="mt-2 leading-6 text-muted">Affichez ou repliez la bibliothèque, l’éditeur et l’aperçu. Redimensionnez-les selon le document ouvert.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Reprenez où vous étiez</h3><p class="mt-2 leading-6 text-muted">Marginalia mémorise les dimensions et la disposition que vous préférez.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Lisez en clair ou en sombre</h3><p class="mt-2 leading-6 text-muted">Choisissez un thème clair ou sombre et ajustez la taille du texte de l’éditeur.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Ouvrez vos fichiers facilement</h3><p class="mt-2 leading-6 text-muted">Sur Windows, ajoutez Marginalia au menu « Ouvrir avec » pour les fichiers Markdown.</p></div>
        <div class="border-t border-rule py-5"><h3 class="font-semibold">Suivez le texte avec précision</h3><p class="mt-2 leading-6 text-muted">L’éditeur affiche les numéros de ligne et permet de rendre visibles espaces, tabulations et fins de ligne. Dans l’aperçu, les blocs de code sont colorés et numérotés.</p></div>
      </div>
    </div>
  </section>

  <section id="compatibilite" class="scroll-mt-8 px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-8 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
        <div><p class="mb-4 text-sm font-semibold text-accent">Pour votre ordinateur</p><h2 class="editorial-title max-w-[12ch] text-4xl leading-tight sm:text-5xl">Vos notes restent chez vous.</h2></div>
        <div>
          <p class="reading-measure text-lg leading-7 text-muted">Ouvrez vos fichiers depuis leur emplacement habituel. Marginalia ne demande ni compte ni abonnement et n’ajoute pas de télémétrie.</p>
          <p class="reading-measure mt-4 leading-7 text-muted">Le projet vise Windows, macOS et Linux. Les préversions publiques à télécharger aujourd’hui sont celles de Windows et Linux; les notes de version précisent les systèmes et paquets réellement publiés.</p>
          <a class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-accent underline decoration-transparent underline-offset-4 hover:decoration-current" href={releaseUrl} target="_blank" rel="noreferrer">Voir les versions disponibles <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 pb-16 sm:px-8 sm:pb-20 lg:px-12">
    <div class="download-panel mx-auto grid max-w-7xl gap-8 rounded-md px-6 py-9 sm:px-10 sm:py-12 md:grid-cols-[1fr_auto] md:items-center lg:px-14">
      <div><p class="mb-3 text-sm font-medium text-[#c7d2fe]">Le code est ouvert, les fichiers restent locaux.</p><h2 class="editorial-title max-w-[17ch] text-3xl leading-tight sm:text-4xl">Essayez Marginalia avec vos propres notes.</h2><p class="mt-4 max-w-[58ch] leading-7 text-[#e1e5ec]">Téléchargez la bêta pour Windows ou Linux depuis les releases officielles. La page de version indique les fichiers, sommes de contrôle et changements.</p></div>
      <a class="inline-flex min-h-12 items-center justify-center gap-2 self-start rounded-md bg-white px-5 py-3 font-semibold text-ink no-underline transition-colors hover:bg-[#e6eaf1] md:self-center" href={releaseUrl} target="_blank" rel="noreferrer">Choisir ma version <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
    </div>
  </section>

  <section id="questions" class="scroll-mt-8 bg-white px-5 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
    <div class="mx-auto grid max-w-7xl gap-9 md:grid-cols-[0.7fr_1.3fr] md:gap-16">
      <div><p class="mb-4 text-sm font-semibold text-accent">Avant de commencer</p><h2 class="editorial-title max-w-[11ch] text-4xl leading-tight sm:text-5xl">Questions fréquentes.</h2></div>
      <div>
        {faqs.map(({ question, answer }) => (
          <details class="faq-item group">
            <summary class="text-base font-medium sm:text-lg">{question}</summary>
            <p class="faq-answer">{answer}</p>
          </details>
        ))}
        <p class="mt-6 text-sm leading-6 text-muted">Un doute sur une version ou un problème rencontré ? <a class="text-link" href={`${repositoryUrl}/issues`} target="_blank" rel="noreferrer">Écrivez-nous sur GitHub <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>.</p>
      </div>
    </div>
  </section>
</SiteLayout>
